@page "/admin/initialize-indexes"
@model Vulpes.Zinc.Web.Pages.InitializeIndexesModel
@{
}

<h1>Initialize</h1>
<p>Congratulations on being an admin.</p>

@foreach (var index in Model.Indexes)
{
    <div class="row">
        <div class="col">
            <h2>@index.Name</h2>
            <p>@(await index.ExistsAsync())</p>
        </div>
    </div>
}


<form method="post">
        <input type="submit" class="btn btn-primary" value="Initialize Indexes" />
</form>